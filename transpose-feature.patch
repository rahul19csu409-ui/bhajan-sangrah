+/* ---------- transpose sheet ---------- */
+.tpsheet{
+  background:var(--card);border:1px solid var(--line);border-radius:var(--r);
+  box-shadow:var(--shadow-lg);width:min(92vw,380px);padding:20px;animation:fade .16s ease;
+}
+.tp-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:4px}
+.tp-head h3{font-family:var(--fd);font-weight:400;font-size:17px}
+.tp-shift{font-size:11.5px;color:var(--teal);font-weight:600;letter-spacing:.04em}
+.tp-row{display:flex;align-items:center;justify-content:center;gap:16px;margin:14px 0 10px}
+.tp-btn{
+  width:44px;height:44px;border-radius:12px;cursor:pointer;font-size:22px;line-height:1;
+  border:1px solid var(--line2);background:var(--field);color:var(--text);
+  display:flex;align-items:center;justify-content:center;transition:all .12s;
+}
+.tp-btn:active{transform:scale(.94)}
+.tp-note{text-align:center;min-width:96px}
+.tp-note .n{font-family:var(--fd);font-size:34px;color:var(--gold);line-height:1.1}
+.tp-note .l{font-size:11px;color:var(--dim2);letter-spacing:.06em;margin-top:2px}
+.tp-keys{display:flex;height:8px;border-radius:4px;overflow:hidden;border:1px solid var(--line);margin:4px 0 14px}
+.tp-keys div{flex:1}
+.tp-keys .w{background:var(--gold-soft)}
+.tp-keys .b{background:#171226}
+.tp-keys .on{background:var(--gold)!important}
+.tp-play{
+  width:100%;padding:12px;border:none;border-radius:11px;cursor:pointer;
+  background:var(--teal);color:#fff;font-size:14.5px;font-weight:600;font-family:var(--fb);
+  display:flex;align-items:center;justify-content:center;gap:8px;transition:background .15s;
+}
+.tp-play.live{background:var(--red)}
+.tp-reset{
+  width:100%;margin-top:8px;padding:9px;border:none;border-radius:10px;cursor:pointer;
+  background:none;color:var(--dim);font-size:12.5px;font-family:var(--fb);
+}
+.tp-open{
+  border:1px solid var(--line);background:var(--field);color:var(--gold-ink);
+  border-radius:8px;padding:3px 9px;font-size:12px;font-weight:700;cursor:pointer;
+  font-family:var(--fb);letter-spacing:.02em;
+}
