@@ -1890,6 +1940,54 @@ window.stopShruti = ()=>{
   const fn = $("fabNote"); if(fn) fn.style.display = "none";
   document.querySelectorAll(".sc.playing").forEach(el=>el.classList.remove("playing"));
   document.querySelectorAll(".tanp-key.playing").forEach(el=>el.classList.remove("playing"));
+  document.querySelectorAll(".tp-play.live").forEach(el=>{ el.classList.remove("live"); });
+};
+
+/* ================= transpose (shift scale + retune tanpura) ================= */
+window.openTranspose = (note, ev)=>{
+  if(ev){ ev.stopPropagation(); ev.preventDefault(); }
+  const baseIdx = SCALES.findIndex(s=>s[0]===note);
+  if(baseIdx < 0) return;
+  let shift = 0;
+  buzz(8);
+  const div = document.createElement("div");
+  div.className = "overlay";
+  navPush(()=>div.remove());
+  div.onclick = (e)=>{ if(e.target===div) navBack(); };
+
+  const cur = ()=> SCALES[(baseIdx + (shift % 12) + 12) % 12];
+
+  function draw(){
+    const [n, label, black] = cur();
+    const playing = (shrutiNote === n);
+    div.innerHTML = `
+      <div class="tpsheet" onclick="event.stopPropagation()">
+        <div class="tp-head">
+          <h3>${t("transpose")}</h3>
+          <span class="tp-shift">${shift===0 ? t("tpOrig") : (shift>0?"+":"")+shift+" "+t("tpSemi")}</span>
+        </div>
+        <div class="tp-row">
+          <button class="tp-btn" id="tp-dn" aria-label="Down one semitone">&minus;</button>
+          <div class="tp-note">
+            <div class="n">${n}</div>
+            <div class="l">${label} &middot; \u0938\u093e</div>
+          </div>
+          <button class="tp-btn" id="tp-up" aria-label="Up one semitone">+</button>
+        </div>
+        <div class="tp-keys">${SCALES.map(s=>`<div class="${s[2]?"b":"w"} ${s[0]===n?"on":""}"></div>`).join("")}</div>
+        <button class="tp-play ${playing?"live":""}" id="tp-go">
+          ${playing ? "\u23f9 "+t("tpStop") : "\u25b6 "+t("tpPlay")+" "+n}
+        </button>
+        ${shift!==0 ? `<button class="tp-reset" id="tp-rst">\u21ba ${t("tpReset")} (${note})</button>` : ""}
+      </div>`;
+    div.querySelector("#tp-dn").onclick = ()=>{ shift--; buzz(6); if(shrutiNote && shrutiNote!==cur()[0]) toggleShruti(cur()[0]); draw(); };
+    div.querySelector("#tp-up").onclick = ()=>{ shift++; buzz(6); if(shrutiNote && shrutiNote!==cur()[0]) toggleShruti(cur()[0]); draw(); };
+    div.querySelector("#tp-go").onclick = ()=>{ toggleShruti(cur()[0]); draw(); };
+    const rst = div.querySelector("#tp-rst");
+    if(rst) rst.onclick = ()=>{ shift = 0; buzz(6); if(shrutiNote && shrutiNote!==note) toggleShruti(note); draw(); };
+  }
+  draw();
+  document.body.appendChild(div);
 };
 
 
